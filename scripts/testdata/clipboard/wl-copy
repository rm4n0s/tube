#!/bin/sh
# The wl-copy of the proofs of the TUI (scripts/tui-proof.sh): it writes what it is given to the
# file that TUBE_PROOF_CLIPBOARD names, and never touches a clipboard. A proof puts this folder
# first in the PATH of the program and gives it a WAYLAND_DISPLAY of its own.
exec cat > "$TUBE_PROOF_CLIPBOARD"
